mponent;\r\n}\r\n\r\nFVector AAuraCharacterBase::GetCombatSocketLocation()\r\n{\r\n\tcheck(Weapon);\r\n\treturn Weapon->GetSocketLocation(WeaponTipSocketName);\r\n}\r\n\r\nUAnimMontage* AAuraCharacterBase::GetHitReactMontage_Implementation()\r\n{\r\n\treturn HitReactMontage;\r\n}\r\n\r\n
